# =============================================================================
# SEC EDGAR RAG System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.
# =============================================================================

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=                    # dev / prod / test

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=<database-name>
DB_USER=<database-user>        # use a least-privilege user in production, not the superuser
DB_PASSWORD=<your-database-password>
DB_POOL_SIZE=20               # must exceed the max parallel retrieval tasks a query fans out into, plus headroom
TEST_DB_NAME=                  # name of the test database — must be set before running integration tests

# ── EDGAR ─────────────────────────────────────────────────────────────────────
EDGAR_USER_AGENT=<project-name contact@example.com>    # required by SEC fair-use policy

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_BASE_URL=http://localhost:11434   # Ollama / vLLM / Modal endpoint; omit for cloud APIs (Claude, OpenAI)
LLM_API_KEY=<your-api-key>            # API key for cloud providers (Claude, OpenAI); leave empty for local models

# ── Tracing ───────────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=          # e.g. http://localhost:6006 for Phoenix — the SDK appends /v1/traces automatically; required when tracing.enabled: true
OTEL_SERVICE_NAME=<your-service-name>       # identifies this service in the trace UI

# ── Evaluation ────────────────────────────────────────────────────────────────
PHOENIX_DB_PATH=<absolute-path-to-phoenix.db>    # required when evaluation.extractor.backend: phoenix
JUDGE_LLM_API_KEY=<your-api-key>       # API key for the LLM used by RAGAS to score answers; independent of LLM_API_KEY
