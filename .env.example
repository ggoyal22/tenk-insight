# =============================================================================
# SEC EDGAR RAG System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.
# =============================================================================

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=                    # dev / prod / test

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sec_edgar
DB_USER=postgres               # use a least-privilege user in production, not the superuser
DB_PASSWORD=
DB_POOL_SIZE=5
TEST_DB_NAME=                  # name of the test database — must be set before running integration tests

# ── EDGAR ─────────────────────────────────────────────────────────────────────
EDGAR_USER_AGENT=              # e.g. "Project Name contact@example.com" — required by SEC fair-use policy

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_BASE_URL=http://localhost:11434   # Ollama / vLLM / Modal endpoint; omit for cloud APIs (Claude, OpenAI)
LLM_API_KEY=                          # API key for cloud providers (Claude, OpenAI); leave empty for local models

# ── Tracing ───────────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=          # e.g. http://localhost:6006 for Phoenix — the SDK appends /v1/traces automatically; required when tracing.enabled: true
OTEL_SERVICE_NAME=sec-edgar-rag       # identifies this service in the trace UI
